# Kimai Development Docker Image
FROM php:8.3-fpm-alpine

# System dependencies
RUN apk add --no-cache \
    bash \
    curl \
    git \
    unzip \
    icu-dev \
    icu-data-full \
    libpng-dev \
    libzip-dev \
    libxslt-dev \
    freetype-dev \
    openldap-dev \
    nodejs \
    npm \
    yarn

# PHP extensions
RUN docker-php-ext-configure gd --with-freetype \
 && docker-php-ext-configure ldap \
 && docker-php-ext-install -j$(nproc) \
    gd \
    intl \
    ldap \
    pdo_mysql \
    zip \
    xsl \
    opcache

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# PHP config (dev)
RUN cp /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini \
 && sed -i 's/memory_limit = 128M/memory_limit = 512M/' /usr/local/etc/php/php.ini \
 && sed -i 's/upload_max_filesize = 2M/upload_max_filesize = 64M/' /usr/local/etc/php/php.ini \
 && sed -i 's/post_max_size = 8M/post_max_size = 64M/' /usr/local/etc/php/php.ini \
 && sed -i 's/;opcache.enable=1/opcache.enable=1/' /usr/local/etc/php/php.ini \
 && sed -i 's/;opcache.validate_timestamps=1/opcache.validate_timestamps=1/' /usr/local/etc/php/php.ini \
 && sed -i 's/;opcache.revalidate_freq=2/opcache.revalidate_freq=0/' /usr/local/etc/php/php.ini

# PHP-FPM config
RUN sed -i 's/listen = 127.0.0.1:9000/listen = 0.0.0.0:9000/' /usr/local/etc/php-fpm.d/www.conf \
 && sed -i 's/;clear_env = no/clear_env = no/' /usr/local/etc/php-fpm.d/www.conf

# Workdir
WORKDIR /var/www/html

# 🔥 КРИТИЧЕСКОЕ ИСПРАВЛЕНИЕ
# Cache и log создаются ВНУТРИ контейнера
RUN mkdir -p /var/www/html/var/cache/dev \
             /var/www/html/var/log \
 && chown -R www-data:www-data /var/www/html/var \
 && chmod -R 777 /var/www/html/var

# Symfony CLI (не обязательно, но пусть будет)
RUN curl -sS https://get.symfony.com/cli/installer | bash \
 && mv /root/.symfony5/bin/symfony /usr/local/bin/symfony || true

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD php-fpm -t || exit 1

CMD ["php-fpm", "-F"]
