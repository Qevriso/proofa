{% set currentRoute = app.request.attributes.get('_route') %}

{# Workspace placeholders: you can pass workspaceName/workspaceMembers/workspaceInitials from controller #}
{% set workspaceName = workspaceName|default('GoodGantt Company GoodGantt GoodGantt') %}
{% set workspaceMembers = workspaceMembers|default('8 участников') %}
{% set workspaceInitials = workspaceInitials|default(null) %}

{% if workspaceInitials is null %}
    {% set parts = workspaceName|trim|split(' ') %}
    {% set first = (parts|length > 0 ? parts[0]|slice(0, 1) : '') %}
    {% set second = (parts|length > 1 ? parts[1]|slice(0, 1) : '') %}
    {% set workspaceInitials = (first ~ second)|upper %}
{% endif %}

<aside class="proofa-sidebar">

    <!-- ================= TOP ================= -->
    <div class="proofa-sidebar__top">

        <button
            class="proofa-workspace-toggle"
            id="workspaceToggle"
            type="button"
        >
            <div class="proofa-workspace">

                <div class="proofa-workspace__logo">{{ workspaceInitials }}</div>

                <div class="proofa-workspace__info">
                    <div class="proofa-workspace__name">{{ workspaceName }}</div>
                    <div class="proofa-workspace__members">{{ workspaceMembers }}</div>
                </div>

            </div>

            {# 🔴 ВМЕСТО ⋮ — SVG #}
           <div class="proofa-workspace__dots">
    <img
        src="{{ asset('icons/sidebar/more.svg') }}"
        alt="Меню"
        class="proofa-workspace__dots-icon"
    >
</div>

        </button>

        <!-- WORKSPACE MENU -->
        <div class="proofa-workspace-menu" id="workspaceMenu">
            <div class="workspace-card">

                <div class="workspace-card__header">
                    <div class="workspace-card__logo">{{ workspaceInitials }}</div>
                    <div>
                        <div class="workspace-card__title">
                            {{ workspaceName }}
                        </div>
                        <div class="workspace-card__subtitle">
                            Бесплатный тариф • {{ workspaceMembers }}
                        </div>
                    </div>
                </div>

                <div class="workspace-card__actions">
                    <a href="{{ path('system_configuration', {'_locale': app.request.locale}) }}" class="btn-outline">
                        <img src="{{ asset('icons/sidebar/settings.svg') }}" alt="">
                        Настройки
                    </a>
                    <a href="{{ path('admin_user_create', {'_locale': app.request.locale}) }}" class="btn-outline">
                        <img src="{{ asset('icons/sidebar/invite.svg') }}" alt="">
                        Пригласить
                    </a>
                </div>

                <div class="workspace-card__list">
                    <div class="workspace-item active">
                        <span class="avatar">A</span>
                        <span>Название_компании</span>
                        <span class="check">✓</span>
                    </div>
                    <div class="workspace-item">
                        <span class="avatar">A</span>
                        <span>Название_компании</span>
                    </div>
                    <div class="workspace-item">
                        <span class="avatar">A</span>
                        <span>Название_компании</span>
                    </div>
                </div>

                <div class="workspace-card__footer">
                    <a href="#">Добавить рабочее пространство</a>
                    <a href="{{ path('logout', {'_locale': app.request.locale}) }}">Выйти</a>
                </div>

            </div>
        </div>
    </div>

    <!-- ================= NAV (WHITE) ================= -->
    <nav class="proofa-nav">
        {% set isDashboardActive = currentRoute starts with 'dashboard' %}
        <a href="{{ path('dashboard', {'_locale': app.request.locale}) }}"
           class="proofa-nav__item {{ isDashboardActive ? 'is-active' }}">
            <img src="{{ asset(isDashboardActive ? 'icons/sidebar/dashboard.svg' : 'icons/sidebar/dashboard-gray.svg') }}" alt="">
            <span>Dashboard</span>
        </a>

        {% set isAiActive = currentRoute starts with 'ai' %}
        <a href="#"
           class="proofa-nav__item {{ isAiActive ? 'is-active' }}">
            <img src="{{ asset(isAiActive ? 'icons/sidebar/ai-blue.svg' : 'icons/sidebar/ai.svg') }}">
            <span>AI ассистент</span>
        </a>

        {% set isCalendarActive = currentRoute starts with 'calendar' %}
        <a href="{{ path('calendar', {'_locale': app.request.locale}) }}"
           class="proofa-nav__item {{ isCalendarActive ? 'is-active' }}">
            <img src="{{ asset(isCalendarActive ? 'icons/sidebar/meetings-blue.svg' : 'icons/sidebar/meetings.svg') }}" alt="">
            <span>Встречи</span>
        </a>

        {% set isReportingActive = currentRoute starts with 'reporting' %}
        <a href="{{ path('reporting', {'_locale': app.request.locale}) }}"
           class="proofa-nav__item {{ isReportingActive ? 'is-active' }}">
            <img src="{{ asset(isReportingActive ? 'icons/sidebar/reports-blue.svg' : 'icons/sidebar/reports.svg') }}" alt="">
            <span>Отчеты</span>
        </a>

        {% set isTimesheetActive = currentRoute starts with 'timesheet' %}
        <a href="{{ path('timesheet', {'_locale': app.request.locale}) }}"
           class="proofa-nav__item {{ isTimesheetActive ? 'is-active' }}">
            <img src="{{ asset(isTimesheetActive ? 'icons/sidebar/activity-blue.svg' : 'icons/sidebar/activity.svg') }}" alt="">
            <span>Активность</span>
        </a>

        {# Проекты и Клиенты — ведёт на admin_project #}
        {% set isProjectsActive = currentRoute starts with 'admin_project' %}
        <a href="{{ path('admin_project', {'_locale': app.request.locale}) }}"
           class="proofa-nav__item {{ isProjectsActive ? 'is-active' }}">
            <img src="{{ asset(isProjectsActive ? 'icons/sidebar/projects-blue.svg' : 'icons/sidebar/projects.svg') }}" alt="">
            <span>Проекты и клиенты</span>
        </a>

        {% set isInvoiceActive = currentRoute starts with 'invoice' %}
        <a href="{{ path('invoice', {'_locale': app.request.locale}) }}"
           class="proofa-nav__item {{ isInvoiceActive ? 'is-active' }}">
            <img src="{{ asset(isInvoiceActive ? 'icons/sidebar/invoices-blue.svg' : 'icons/sidebar/invoices.svg') }}" alt="">
            <span>Счета</span>
        </a>
    </nav>

    <!-- ================= BOTTOM ================= -->
<!-- ================= BOTTOM ================= -->
<div class="proofa-sidebar__bottom">
    <a href="{{ path('system_configuration', {'_locale': app.request.locale}) }}" class="proofa-nav__item">
        <img src="{{ asset('icons/sidebar/team.svg') }}" alt="">
        <span>Настройки команды</span>
    </a>
    <a href="{{ path('plugins', {'_locale': app.request.locale}) }}" class="proofa-nav__item">
        <img src="{{ asset('icons/sidebar/more.svg') }}" alt="">
        <span>Еще</span>
    </a>
</div>


</aside>


<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('workspaceToggle');
    const menu   = document.getElementById('workspaceMenu');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        menu.classList.toggle('open');
    });

    document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !toggle.contains(e.target)) {
            menu.classList.remove('open');
        }
    });
});
</script>
