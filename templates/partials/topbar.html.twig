{# =========================================
   PROOFA TOPBAR (CONFIG-DRIVEN, SAFE)
   ========================================= #}

{% set currentRoute = app.request.attributes.get('_route') %}
{% set queryAll = app.request.query.all %}
{% set topbarConfig = proofa_topbar_config %}
{% set section = null %}

{# 1. Определяем секцию по match #}
{% for key, candidate in topbarConfig %}
    {% for prefix in candidate.match %}
        {% if currentRoute starts with prefix %}
            {% set section = candidate %}
        {% endif %}
    {% endfor %}
{% endfor %}

{# 2. Рендер #}
{% if section %}
<div class="proofa-topbar">
    <div class="proofa-topbar__inner">

        <div class="proofa-topbar__row">
            <h1 class="proofa-topbar__title">
                {{ section.title }}
            </h1>

            {# ===== ACTIONS (RIGHT) ===== #}
            <div class="proofa-topbar__actions">

                {# three dots — same icon as sidebar #}
                <button
                    type="button"
                    class="proofa-topbar__icon-btn"
                    aria-label="Actions"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="5" r="2" fill="currentColor"/>
                        <circle cx="12" cy="12" r="2" fill="currentColor"/>
                        <circle cx="12" cy="19" r="2" fill="currentColor"/>
                    </svg>
                </button>

                {# import button — ONLY for timesheet #}
                {% if currentRoute starts with 'timesheet' %}
                    <a
                        href="#"
                        class="proofa-btn proofa-btn--outline"
                    >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"/>
                        </svg>
                        Импортировать задачи
                    </a>
                {% endif %}

                {# existing CREATE button — untouched #}
                {% if currentRoute starts with 'timesheet'
                      and is_granted('create_timesheet') %}
                    <a
                        href="{{ path('timesheet_create') }}"
                        class="btn btn-primary"
                    >
                        Создать
                    </a>
                {% endif %}

            </div>
        </div>

        {# ===== TABS ===== #}
        <nav class="proofa-topbar__nav">
            {% for tab in section.tabs %}
                {% set tabQuery = tab.query ?? {} %}
                {% set isActive = (currentRoute == tab.route) %}

                {% if isActive and tabQuery %}
                    {% for k, v in tabQuery %}
                        {% if (queryAll[k] ?? null) != v %}
                            {% set isActive = false %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                <a
                    href="{{ path(tab.route, tabQuery) }}"
                    class="proofa-topbar__link {{ isActive ? 'is-active' }}"
                >
                    {{ tab.label }}
                </a>
            {% endfor %}
        </nav>

    </div>
</div>
{% endif %}
